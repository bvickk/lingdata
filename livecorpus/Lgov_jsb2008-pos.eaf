                <ANNOTATION_VALUE>Он такой круток.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a884"
                TIME_SLOT_REF1="ts1257" TIME_SLOT_REF2="ts1258">
                <ANNOTATION_VALUE>И включается как способ движения.</ANNOTATION_VALUE>
