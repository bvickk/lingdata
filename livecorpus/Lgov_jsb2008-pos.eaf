        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a846"
                TIME_SLOT_REF1="ts1181" TIME_SLOT_REF2="ts1182">
                <ANNOTATION_VALUE>что мы даже с тобой обсуждали</ANNOTATION_VALUE>
