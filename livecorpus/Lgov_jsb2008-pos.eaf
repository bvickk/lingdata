        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a885"
                TIME_SLOT_REF1="ts1259" TIME_SLOT_REF2="ts1260">
                <ANNOTATION_VALUE>Очень классный зимой и вечером.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a886"
                TIME_SLOT_REF1="ts1261" TIME_SLOT_REF2="ts1262">
                <ANNOTATION_VALUE>А на клинках давно катаешься?</ANNOTATION_VALUE>
