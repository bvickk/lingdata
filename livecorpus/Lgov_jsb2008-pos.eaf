        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a887"
                TIME_SLOT_REF1="ts1263" TIME_SLOT_REF2="ts1264">
                <ANNOTATION_VALUE>Или просто в детстве катаешься?</ANNOTATION_VALUE>
