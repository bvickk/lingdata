        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a900"
                TIME_SLOT_REF1="ts1289" TIME_SLOT_REF2="ts1290">
                <ANNOTATION_VALUE>Это смена стиля?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a901"
                TIME_SLOT_REF1="ts1291" TIME_SLOT_REF2="ts1292">
                <ANNOTATION_VALUE>Ты решила с краешком походить</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a902"
                TIME_SLOT_REF1="ts1293" TIME_SLOT_REF2="ts1294">
                <ANNOTATION_VALUE>или просто уже длинные</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a903"
                TIME_SLOT_REF1="ts1295" TIME_SLOT_REF2="ts1296">
                <ANNOTATION_VALUE>мобильные?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
